{
  "name": "clips",
  "version": "1.0.0",
  "description": "3D-animierte Videos mit Three.js (React Three Fiber) und Remotion",
  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@fontsource/montserrat": "5.3.0",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.2.0",
    "@remotion/animation-utils": "4.0.541",
    "@remotion/captions": "4.0.541",
    "@remotion/cli": "4.0.541",
    "@remotion/layout-utils": "4.0.541",
    "@remotion/media": "4.0.541",
    "@remotion/media-utils": "4.0.541",
    "@remotion/three": "4.0.541",
    "@remotion/zod-types": "4.0.541",
    "mediabunny": "1.64.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.541",
    "three": "0.178.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.541",
    "@remotion/install-whisper-cpp": "4.0.541",
    "@types/react": "19.3.0",
    "@types/three": "0.170.0",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "render": "remotion render Animated3D out/animated3d.mp4",
    "still": "remotion still Animated3D out/animated3d.png --frame=60",
    "transcribe": "node scripts/transcribe.mjs",
    "lint": "eslint src && tsc",
    "upgrade": "remotion upgrade",
    "setup:voice": ".venv/bin/python scripts/tts.py --setup",
    "episode": ".venv/bin/python scripts/make_episode.py",
    "render:episode": "remotion render SolarSystem out/solar-system.mp4",
    "contactsheet": "node scripts/contactsheet.mjs",
    "calibrate": ".venv/bin/python scripts/calibrate_speed.py",
    "scaffold": "node scripts/scaffold_episode.mjs"
  },
  "allowScripts": {
    "esbuild": false
  }
}
